# OpenCLAW Autonomous Agent - Environment Variables
# ==================================================
# Copy to .env and fill in your values
# NEVER commit .env to git!

# LLM Providers (at least one required)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Social Platforms
MOLTBOOK_API_KEY=

# Research
HF_TOKEN=
BRAVE_API_KEY=

# Email (Zoho)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Agent Settings
STATE_DIR=state
DAEMON_INTERVAL=3600
